PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/taskManagement
JWT_SECRET=replace-with-a-long-random-secret

# SMTP settings (Gmail example: smtp.gmail.com, port 465, secure TLS)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-account@example.com
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM=Task Management <your-smtp-account@example.com>

# Public URL of the frontend, used in invitation links
FRONTEND_URL=http://localhost:5173
